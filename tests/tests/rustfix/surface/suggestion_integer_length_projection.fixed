//@run-rustfix
//@normalize-stderr-test: "(?s).*" -> ""
//@rustfix-only-machine-applicable
//@compile-flags: -Fsuggestions=true -Ffix-suggestions
#[path = "../../lib/rvec.rs"]
mod rvec;

use rvec::RVec;

#[flux::sig(fn(&crate::rvec::RVec<T>[@n], usize[@v]) -> &T requires v < n.len)]
fn index<T>(n: &RVec<T>, v: usize) -> &T {
    n.get(v)
}

#[flux::no_suggestions]
fn witness() {
    let values = RVec::from_array([42]);
    let _ = index(&values, 0);
}
