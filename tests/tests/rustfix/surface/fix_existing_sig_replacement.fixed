//@run-rustfix
//@normalize-stderr-test: "(?s).*" -> ""
//@rustfix-only-machine-applicable
//@compile-flags: -Fsuggestions=true -Ffix-suggestions
#[flux::trusted]
#[flux::sig(fn(i32{v: 0 < v}))]
fn needs_pos(_value: i32) {}

#[flux::trusted]
#[flux::sig(fn(i32{v: v < 10}))]
fn needs_small(_value: i32) {}

#[flux::sig(fn(i32[@x]) -> () requires 0 < x && x < 10)]
pub fn foo(x: i32) {
    needs_pos(x);
    needs_small(x);
}

#[flux::spec( fn(i32[@x]) -> () requires 0 < x && x < 10 )]
pub fn foo_with_spec(x: i32) {
    needs_pos(x);
    needs_small(x);
}

#[flux::no_suggestions]
fn witness() {
    foo(5);
    foo_with_spec(5);
}
